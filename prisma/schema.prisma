generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URI")
}

model Event {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  date             String?
  time             String?
  venue            String?
  unit             String?
  unitSlug         String?
  category         String?
  status           String?
  description      String?
  imageSrc         String?
  registrationLink String?

  @@map("events")
}

model Achievement {
  id          String  @id @default(cuid())
  year        String
  title       String
  conferredBy String?
  unitOrTeam  String?
  category    String?
  description String?

  @@map("achievements")
}

model SiteSetting {
  id                   String  @id
  announcementMessage  String?
  announcementLinkText String?
  announcementLinkHref String?
  announcementActive   Boolean @default(true)

  @@map("site_settings")
}

model Officer {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  password  String
  role      String?
  category  String?
  createdAt String?
  createdBy String?

  @@map("officers")
}

model AuditLog {
  id            String  @id @default(cuid())
  timestamp     String
  performedBy   String
  actionType    String
  entityType    String
  entityTitle   String?
  changeSummary String?

  @@map("audit_logs")
}

model Chapter {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  type            String
  parentSociety   String?
  establishedYear String?
  description     String?
  mission         String?
  leaderName      String?
  leaderRole      String?
  memberCount     Int     @default(0)
  eventCount      Int     @default(0)

  @@map("chapters")
}

model Story {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  date        String
  author      String
  category    String
  excerpt     String
  contentHtml String
  imageUrl    String?

  @@map("stories")
}

model Gallery {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  date        String
  category    String
  coverImage  String
  imageCount  Int     @default(0)
  description String?
  photos      GalleryPhoto[]

  @@map("galleries")
}

model GalleryPhoto {
  id        String  @id @default(cuid())
  galleryId String
  caption   String
  url       String?
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@map("gallery_photos")
}

model Person {
  id           String  @id @default(cuid())
  name         String
  role         String
  department   String?
  academicYear String?
  hierarchy    String
  category     String?
  imageUrl     String?

  @@map("people")
}
