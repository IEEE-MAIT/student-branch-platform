generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  date             String?
  time             String?
  venue            String?
  unit             String?
  unitSlug         String?
  category         String?
  status           String?
  description      String?
  imageSrc         String?
  images           String[]      @default([])
  registrationLink String?
  galleryId        String?
  storyId          String?
  chapterId        String?
  academicYearId   String?
  gallery          Gallery?      @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  story            Story?        @relation("EventReport", fields: [storyId], references: [id], onDelete: SetNull)
  chapter          Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  academicYear     AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  achievements     Achievement[]

  @@map("events")
}

model Achievement {
  id             String              @id @default(cuid())
  year           String
  title          String
  conferredBy    String?
  unitOrTeam     String?
  category       String?
  description    String?
  imageSrc       String?
  images         String[]            @default([])
  chapterId      String?
  eventId        String?
  academicYearId String?
  chapter        Chapter?            @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  event          Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear?       @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  people         AchievementPerson[]

  @@map("achievements")
}

model AchievementPerson {
  achievementId String
  personId      String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  person        Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([achievementId, personId])
  @@map("achievement_people")
}

model SiteSetting {
  id                   String  @id
  announcementMessage  String?
  announcementLinkText String?
  announcementLinkHref String?
  announcementActive   Boolean @default(true)

  @@map("site_settings")
}

model Officer {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  password  String
  role      String?
  category  String?
  createdAt String?
  createdBy String?

  @@map("officers")
}

model AuditLog {
  id            String  @id @default(cuid())
  timestamp     String
  performedBy   String
  actionType    String
  entityType    String
  entityTitle   String?
  changeSummary String?

  @@map("audit_logs")
}

model Chapter {
  id              String                   @id @default(cuid())
  name            String
  slug            String                   @unique
  type            String
  parentSociety   String?
  establishedYear String?
  description     String?
  mission         String?
  leaderName      String?
  leaderRole      String?
  memberCount     Int                      @default(0)
  eventCount      Int                      @default(0)
  events          Event[]
  achievements    Achievement[]
  stories         Story[]
  galleries       Gallery[]
  memberships     OrganizationMembership[]

  @@map("chapters")
}

model Story {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  date        String
  author      String
  authorId    String?
  category    String
  excerpt     String
  contentHtml String
  imageUrl    String?
  chapterId   String?
  authorPerson Person?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  chapter     Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  events      Event[]  @relation("EventReport")

  @@map("stories")
}

model Gallery {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  date        String
  category    String
  coverImage  String
  imageCount  Int            @default(0)
  description String?
  chapterId   String?
  chapter     Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  photos      GalleryPhoto[]
  events      Event[]

  @@map("galleries")
}

model GalleryPhoto {
  id        String  @id @default(cuid())
  galleryId String
  caption   String
  url       String?
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@map("gallery_photos")
}

model Role {
  id          String                   @id @default(cuid())
  title       String                   @unique
  hierarchy   Int                      @default(1)
  category    String // SEC | Lead | ChapterEC | MentorRole
  isActive    Boolean                  @default(true)
  memberships OrganizationMembership[]

  @@map("roles")
}

model AcademicYear {
  id           String                   @id @default(cuid())
  label        String                   @unique // e.g. "2025-26"
  startDate    String?
  endDate      String?
  isCurrent    Boolean                  @default(false)
  memberships  OrganizationMembership[]
  events       Event[]
  achievements Achievement[]

  @@map("academic_years")
}

model Person {
  id           String                   @id @default(cuid())
  name         String
  role         String
  department   String?
  academicYear String?
  hierarchy    Int                      @default(10)
  category     String?
  imageUrl     String?
  email        String?
  linkedIn     String?
  github       String?
  bio          String?
  memberships  OrganizationMembership[]
  stories      Story[]
  achievements AchievementPerson[]

  @@map("people")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  personId       String
  roleId         String
  academicYearId String
  chapterId      String?
  startDate      String?
  endDate        String?
  isCurrent      Boolean      @default(true)
  sortOrder      Int          @default(0)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  chapter        Chapter?     @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@map("organization_memberships")
}

model Milestone {
  id          String  @id @default(cuid())
  year        String
  title       String
  description String?
  category    String?
  sortOrder   Int     @default(0)

  @@map("milestones")
}

model Resource {
  id            String  @id @default(cuid())
  title         String
  type          String // Newsletter | AnnualReport | Document | Other
  fileUrl       String?
  publishedDate String
  description   String?
  status        String  @default("published")

  @@map("resources")
}

model Inquiry {
  id        String  @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String  @default("Unread")
  createdAt String
  
  @@map("inquiries")
}
