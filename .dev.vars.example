# Wrangler local dev environment variables
NEXTJS_ENV=development
PAYLOAD_SECRET=your-payload-secret-key-here

DATABASE_URI="postgresql://username:password@ep-host-name.cloud.neon.tech/neondb?sslmode=require"
DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=your_prisma_accelerate_api_key"

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
